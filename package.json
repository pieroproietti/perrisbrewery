{
  "name": "perrisbrewery",
  "description": "Create manpages, insert preinst, postinst, prerm and postrm",
  "version": "26.8.29",
  "type": "module",
  "author": "Piero Proietti",
  "bin": {
    "pb": "./bin/run.js"
  },
  "bugs": "https://github.com/pieroproietti/perrisbrewery/issues",
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-autocomplete": "^3.3.0",
    "@oclif/plugin-help": "^6.3.0",
    "@oclif/plugin-version": "^2.4.0",
    "@oclif/test": "^4.2.0",
    "chalk": "^6.0.0",
    "fs-extra": "^11.4.0",
    "js-yaml": "^5.4.1",
    "mustache": "^4.2.0",
    "rehype-document": "^7.0.3",
    "rehype-format": "^5.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-man": "^9.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "to-vfile": "^8.0.0",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-oclif": "^7.1.7",
    "eslint-config-prettier": "^10.1.8",
    "globby": "^16.2.4",
    "nps": "^5.10.0",
    "oclif": "^4.24.0",
    "ts-node": "^10.9.2"
  },
  "dirname": "pb",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/perrisbrewery"
  ],
  "homepage": "https://penguins-eggs.net",
  "keywords": [
    "oclif",
    "penguins-eggs"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "oclif": {
    "bin": "pb",
    "commands": "./dist/commands",
    "dirname": "pb",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": "pieroproietti/perrisbrewery",
  "scripts": {
    "build": "tsc -p .",
    "lint-and-fix": "eslint . --ext .ts --fix --config .eslintrc",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "posttest": "eslint . --ext .ts --config .eslintrc",
    "prepack": "rm -rf lib && tsc -b && oclif readme",
    "test": "echo NO TESTS",
    "version": "oclif readme && git add README.md"
  },
  "publishConfig": {
    "not_used_registry": "http://localhost:4873",
    "registry": "https://registry.npmjs.org"
  },
  "types": "dist/index.d.ts"
}